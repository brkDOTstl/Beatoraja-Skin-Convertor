{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Beatoraja Skin Convertor",
  "version": "0.1.3",
  "identifier": "io.github.brkdotstl.beatoraja-skin-convertor",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Beatoraja Skin Convertor",
        "width": 1180,
        "height": 760,
        "minWidth": 980,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
